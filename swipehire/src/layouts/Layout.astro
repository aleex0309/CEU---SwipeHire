---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'SwipeHire',
	description = 'SwipeHire turns recruitment into a fast, intuitive matching experience.'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/image.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-full bg-slate-950 selection:bg-indigo-500/40 selection:text-white">
		<a
			href="/"
			class="fixed left-4 top-4 z-50 inline-flex items-center gap-2 rounded-full border border-white/15 bg-slate-900/75 px-3 py-2 shadow-xl backdrop-blur transition hover:border-white/30"
			aria-label="SwipeHire home"
		>
			<img src="/image.png" alt="SwipeHire flame logo" class="h-6 w-6" />
			<span class="text-xs font-bold tracking-wide text-slate-100">SwipeHire</span>
		</a>
		<slot />
	</body>
</html>
